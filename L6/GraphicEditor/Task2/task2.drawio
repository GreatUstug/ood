        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;flowchart TB\n    %% ===== ВНЕШНИЕ СИСТЕМЫ =====\n    subgraph EXT[\&quot;Внешние системы\&quot;]\n        direction LR\n        SFML[\&quot;SFML&lt;br/&gt;&lt;i&gt;External system&lt;/i&gt;&lt;br/&gt;Окно, ввод, графика\&quot;]\n        PFD[\&quot;portable-file-dialogs&lt;br/&gt;&lt;i&gt;External system&lt;/i&gt;&lt;br/&gt;Нативные диалоги\&quot;]\n        FS[\&quot;File System&lt;br/&gt;&lt;i&gt;External system&lt;/i&gt;&lt;br/&gt;Файлы документов\&quot;]\n    end\n\n    %% ===== ГРАНИЦА ПРИЛОЖЕНИЯ =====\n    subgraph APP[\&quot;Graphical Editor (C4 Container)\&quot;]\n\n        WIN[\&quot;&lt;b&gt;Window / Composition Root&lt;/b&gt;&lt;br/&gt;&lt;i&gt;C++ / SFML&lt;/i&gt;&lt;br/&gt;EditorWindowController, EditorController,&lt;br/&gt;DocumentRegistry, WindowAction&lt;br/&gt;Создаёт View и контроллеры, рендер-цикл,&lt;br/&gt;pollEvent, мультидокументность\&quot;]\n\n        %% ----- Controllers -----\n        subgraph CTRL[\&quot;Controllers\&quot;]\n            direction LR\n            ROUTER[\&quot;&lt;b&gt;Input Routing&lt;/b&gt;&lt;br/&gt;&lt;i&gt;C++&lt;/i&gt;&lt;br/&gt;InputRouter&lt;br/&gt;Маршрутизация SFML-событий,&lt;br/&gt;hit-test панелей, создание&lt;br/&gt;Delete / Color / timeline команд\&quot;]\n            SHORTCUTS[\&quot;&lt;b&gt;Shortcuts&lt;/b&gt;&lt;br/&gt;&lt;i&gt;C++&lt;/i&gt;&lt;br/&gt;ShortcutController&lt;br/&gt;Ctrl+S/O/N/D, Delete,&lt;br/&gt;Ctrl+Z/Y, Ctrl+G / Ctrl+Shift+G&lt;br/&gt;возвращает WindowAction\&quot;]\n            CREATE[\&quot;&lt;b&gt;Shape Creation&lt;/b&gt;&lt;br/&gt;&lt;i&gt;C++&lt;/i&gt;&lt;br/&gt;ShapeCreateController,&lt;br/&gt;MakeShapeUtils, ResizePolicy&lt;br/&gt;Start / Begin / UpdatePreview /&lt;br/&gt;Commit → AddCommand\&quot;]\n            TRANSFORM[\&quot;&lt;b&gt;Shape Transform&lt;/b&gt;&lt;br/&gt;&lt;i&gt;C++&lt;/i&gt;&lt;br/&gt;ShapeTransformController&lt;br/&gt;TryStartResize / HandleShapeClick /&lt;br/&gt;Update / Release →&lt;br/&gt;MoveShapes / Resize\&quot;]\n            DOCIO[\&quot;&lt;b&gt;Document IO &amp;amp; File Dialog&lt;/b&gt;&lt;br/&gt;&lt;i&gt;C++ / portable-file-dialogs&lt;/i&gt;&lt;br/&gt;DocumentController, DocumentIO,&lt;br/&gt;SaveService, LoadService, FileDialog&lt;br/&gt;New / Save / Load,&lt;br/&gt;рекурсивная сериализация групп\&quot;]\n        end\n\n        %% ----- Model -----\n        subgraph MODEL[\&quot;Model\&quot;]\n            direction LR\n            DOCMODEL[\&quot;&lt;b&gt;Document Model&lt;/b&gt;&lt;br/&gt;&lt;i&gt;C++&lt;/i&gt;&lt;br/&gt;Document, Picture, Figure,&lt;br/&gt;GroupFigure, PrimitiveFigure&lt;br/&gt;Хранение фигур, порядок, иерархия,&lt;br/&gt;время/длительность, observer-уведомления\&quot;]\n            STATE[\&quot;&lt;b&gt;Editor State&lt;/b&gt;&lt;br/&gt;&lt;i&gt;C++&lt;/i&gt;&lt;br/&gt;EditorState, Bounds, Handle&lt;br/&gt;Выделение, primary, режим, preview,&lt;br/&gt;currentTime, colorMode\&quot;]\n        end\n\n        %% ----- Commands -----\n        subgraph CMDS[\&quot;Commands\&quot;]\n            CMDS_BOX[\&quot;&lt;b&gt;Command &amp;amp; Undo History&lt;/b&gt;&lt;br/&gt;&lt;i&gt;C++&lt;/i&gt;&lt;br/&gt;ICommand, CommandHistory,&lt;br/&gt;Add / Delete / Move / Resize / Color /&lt;br/&gt;SetTime / SetDuration / Reorder /&lt;br/&gt;Group / Ungroup\&quot;]\n        end\n\n        %% ----- Views -----\n        subgraph VIEWS[\&quot;Views\&quot;]\n            direction LR\n            SCENE[\&quot;&lt;b&gt;Scene View&lt;/b&gt;&lt;br/&gt;&lt;i&gt;C++ / SFML&lt;/i&gt;&lt;br/&gt;EditorView, Toolbar, CursorType&lt;br/&gt;Рендер сцены, preview создания,&lt;br/&gt;рамок, toolbar, курсоров\&quot;]\n            PANELS[\&quot;&lt;b&gt;Panel Views&lt;/b&gt;&lt;br/&gt;&lt;i&gt;C++ / SFML&lt;/i&gt;&lt;br/&gt;ShapeListView, TimelineView&lt;br/&gt;Список фигур и таймлайн,&lt;br/&gt;подписаны на Picture + EditorState\&quot;]\n            RENDER[\&quot;&lt;b&gt;Rendering / Canvas Abstraction&lt;/b&gt;&lt;br/&gt;&lt;i&gt;C++ / SFML&lt;/i&gt;&lt;br/&gt;ICanvas, SFMLCanvas,&lt;br/&gt;DrawVisitor, DrawSelectionFrame&lt;br/&gt;Абстракция рисования, Visitor\&quot;]\n        end\n    end\n\n    %% ===== СВЯЗИ =====\n    WIN --&gt;|владеет, Render| SCENE\n    WIN --&gt;|владеет, Render| PANELS\n    WIN --&gt;|делегирует события| ROUTER\n    WIN --&gt;|New / Save / Load| DOCIO\n    WIN -.-&gt;|владеет Document| DOCMODEL\n\n    ROUTER --&gt;|hit-test, HandleClick| PANELS\n    ROUTER --&gt;|UpdateCursor| SCENE\n    ROUTER --&gt;|Start / Commit| CREATE\n    ROUTER --&gt;|Resize / Drag| TRANSFORM\n    ROUTER --&gt;|OnKeyPressed| SHORTCUTS\n    ROUTER --&gt;|Execute(Delete/Color/SetTime/SetDuration/Reorder)| CMDS_BOX\n    ROUTER --&gt;|selection / mode / preview| STATE\n\n    CREATE --&gt;|Execute(AddCommand)| CMDS_BOX\n    TRANSFORM --&gt;|Execute(MoveShapes / Resize)| CMDS_BOX\n    TRANSFORM --&gt;|preview, dragAnchor, resizeStart| STATE\n\n    SHORTCUTS --&gt;|Execute(Delete/Group/Ungroup), Undo/Redo| CMDS_BOX\n    SHORTCUTS --&gt;|Save| DOCIO\n\n    DOCIO --&gt;|ReplaceWith, Save / Load| DOCMODEL\n    DOCIO --&gt;|диалоги| PFD\n    DOCIO --&gt;|чтение / запись| FS\n\n    SCENE --&gt;|GetOrder / GetShape| DOCMODEL\n    SCENE --&gt;|preview / selection / currentTime| STATE\n    SCENE --&gt;|DrawVisitor, DrawSelectionFrame| RENDER\n\n    PANELS --&gt;|Subscribe, GetOrder / GetShape| DOCMODEL\n    PANELS --&gt;|Subscribe, preview, SetSelectedIds| STATE\n\n    DOCMODEL -.-&gt;|OnPictureChanged (observer)| PANELS\n    STATE -.-&gt;|OnSelectionChanged (observer)| PANELS\n\n    RENDER --&gt;|рисует через| SFML\n    WIN --&gt;|окно, события| SFML\n\n    %% ===== СТИЛИ =====\n    classDef ext fill:#ffcdd2,stroke:#b71c1c,stroke-width:2px,color:#000;\n    classDef win fill:#e0e0e0,stroke:#424242,stroke-width:2px,color:#000;\n    classDef ctrl fill:#c8e6c9,stroke:#2e7d32,stroke-width:1px,color:#000;\n    classDef model fill:#bbdefb,stroke:#1565c0,stroke-width:1px,color:#000;\n    classDef cmds fill:#fff59d,stroke:#f57f17,stroke-width:1px,color:#000;\n    classDef view fill:#ffe0b2,stroke:#e65100,stroke-width:1px,color:#000;\n\n    class SFML,PFD,FS ext;\n    class WIN win;\n    class ROUTER,SHORTCUTS,CREATE,TRANSFORM,DOCIO ctrl;\n    class DOCMODEL,STATE model;\n    class CMDS_BOX cmds;\n    class SCENE,PANELS,RENDER view;&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="ZKvtOslu-q16rbM2jSfc-1">
